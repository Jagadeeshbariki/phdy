rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin') || request.auth.token.email == 'vyomanautjagadeesh@gmail.com';
    }

    function isTreasurer() {
      return hasRole('treasurer') || isAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['admin', 'treasurer', 'phdy_member', 'user'];
    }

    function isValidJoinRequest(data) {
      return data.keys().hasAll(['fullName', 'email', 'status']) &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.status in ['In Progress', 'Approved', 'Rejected'];
    }

    function isValidMember(data) {
      return data.keys().hasAll(['name', 'idNo']) &&
             data.name is string && data.name.size() <= 100 &&
             data.idNo is string && data.idNo.size() <= 50;
    }

    function isValidAccounting(data) {
      return data.keys().hasAll(['FinancialYear', 'Month', 'Type', 'Description', 'amount']) &&
             data.FinancialYear is string && data.Month is string &&
             data.Type in ['Income', 'Expenditure'] && data.Description is string &&
             data.amount is number;
    }

    function isValidWork(data) {
      return data.keys().hasAll(['title', 'description', 'date']) &&
             data.title is string && data.description is string && data.date is string;
    }

    function isValidPhdyFund(data) {
      return data.keys().hasAll(['date', 'name', 'type', 'amount', 'purpose']) &&
             data.date is string && data.name is string &&
             data.type in ['Credit', 'Debit'] && data.amount is number &&
             data.purpose is string;
    }

    // 4. Collection Matches
    
    // System Collection (for health checks)
    match /system/ping {
      allow read: if true;
    }

    // Users Collection
    match /users/{email} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email == email) || hasRole('phdy_member') || hasRole('treasurer');
      allow write: if isAdmin();
    }

    // Join Requests Collection
    match /join_requests/{requestId} {
      allow read: if isAdmin() || (resource.data.status == 'In Progress');
      allow create: if isValidJoinRequest(incoming()) && incoming().status == 'In Progress';
      allow update, delete: if isAdmin();
    }

    // Members Collection
    match /members/{memberId} {
      allow read: if true;
      allow write: if isAdmin() && isValidMember(incoming());
    }

    // Accounting Collection
    match /accounting/{recordId} {
      allow read: if true;
      allow write: if isTreasurer() && isValidAccounting(incoming());
    }

    // Works Collection
    match /works/{workId} {
      allow read: if true;
      allow write: if isAdmin() && isValidWork(incoming());
    }

    // PHDY Internal Funds Collection
    match /phdy_funds/{fundId} {
      allow read: if hasRole('phdy_member') || isTreasurer();
      allow write: if isTreasurer() && isValidPhdyFund(incoming());
    }
  }
}
