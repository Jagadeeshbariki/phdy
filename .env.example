# Supabase Configuration for Pedda Harivanam Youth (PHDY) Portal
# Get credentials from: Supabase Dashboard > Project Settings > API

# OPTION A (Standard Vite / Client-side):
# In Vercel, set the Type dropdown from "Sensitive" to "Config" (Plain text),
# because the anon key is public and designed for browser client access.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OPTION B (Vercel without prefix):
# You can also use non-prefixed names directly in Vercel if you prefer:
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
