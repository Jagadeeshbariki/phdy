{
  "entities": {
    "User": {
      "title": "System User",
      "description": "Represents a user with system access (admin, treasurer, member).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Display name of the user" },
        "email": { "type": "string", "format": "email", "description": "Primary email address" },
        "role": { "type": "string", "enum": ["admin", "treasurer", "phdy_member", "user"], "description": "User access level" },
        "joinedDate": { "type": "string", "format": "date", "description": "Date the user was added" },
        "status": { "type": "string", "enum": ["Active", "Inactive"], "description": "Account status" }
      },
      "required": ["name", "email", "role"]
    },
    "JoinRequest": {
      "title": "Membership Join Request",
      "description": "A submission from someone wishing to join PHDY.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string", "description": "Applicant full name" },
        "email": { "type": "string", "format": "email", "description": "Applicant email" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "dob": { "type": "string", "description": "Date of birth" },
        "address": { "type": "string", "description": "Residential address" },
        "reason": { "type": "string", "description": "Motivation for joining" },
        "photoUrl": { "type": "string", "description": "URL to applicant photo" },
        "status": { "type": "string", "enum": ["In Progress", "Approved", "Rejected"], "description": "Current status of the request" },
        "date": { "type": "string", "description": "Submission date" }
      },
      "required": ["fullName", "email", "status"]
    },
    "Member": {
      "title": "PHDY Member",
      "description": "Information about a verified PHDY member for the public listing.",
      "type": "object",
      "properties": {
        "idNo": { "type": "string", "description": "Unique identification number" },
        "name": { "type": "string", "description": "Member name" },
        "age": { "type": "string", "description": "Member age" },
        "dob": { "type": "string", "description": "Date of birth" },
        "qualification": { "type": "string", "description": "Educational qualification" },
        "motivation": { "type": "string", "description": "Member motivation" },
        "imageUrl": { "type": "string", "description": "Member photo URL" },
        "status": { "type": "string", "description": "Verification status" },
        "source": { "type": "string", "description": "Source of membership (e.g., Founding, Approved Request)" },
        "address": { "type": "string", "description": "Village address" },
        "email": { "type": "string", "description": "Contact email" },
        "phone": { "type": "string", "description": "Contact phone" }
      },
      "required": ["name", "idNo"]
    },
    "AccountingRecord": {
      "title": "Accounting Transaction",
      "description": "A financial income or expense record.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date", "description": "Transaction date" },
        "description": { "type": "string", "description": "Details of the transaction" },
        "amount": { "type": "number", "description": "Monetary value" },
        "type": { "type": "string", "enum": ["Income", "Expense"], "description": "Transaction category" },
        "category": { "type": "string", "description": "Specific budget category" }
      },
      "required": ["date", "description", "amount", "type"]
    },
    "WorkRecord": {
      "title": "Completed Work",
      "description": "A record of a completed village development project.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Project title" },
        "description": { "type": "string", "description": "Project details" },
        "date": { "type": "string", "description": "Completion date" },
        "imageUrls": { "type": "array", "description": "List of project photo URLs" },
        "docUrls": { "type": "array", "description": "List of related document URLs" }
      },
      "required": ["title", "description", "date"]
    },
    "PhdyFundTransaction": {
      "title": "PHDY Internal Fund",
      "description": "Internal youth group fund transaction record.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "Transaction date" },
        "name": { "type": "string", "description": "Contributor or payee name" },
        "type": { "type": "string", "enum": ["Credit", "Debit"], "description": "Transaction type" },
        "amount": { "type": "number", "description": "Transaction amount" },
        "purpose": { "type": "string", "description": "Reason for transaction" },
        "category": { "type": "string", "description": "Fund category" },
        "mode": { "type": "string", "description": "Payment mode (e.g. UPI, Cash)" },
        "receiptUrl": { "type": "string", "description": "URL to receipt image/file" }
      },
      "required": ["date", "name", "type", "amount", "purpose"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Collection of system users and their roles."
    },
    "join_requests": {
      "schema": "JoinRequest",
      "description": "Collection of membership applications."
    },
    "members": {
      "schema": "Member",
      "description": "Public directory of PHDY members."
    },
    "accounting": {
      "schema": "AccountingRecord",
      "description": "Financial ledger of income and expenses."
    },
    "works": {
      "schema": "WorkRecord",
      "description": "Gallery of completed village development works."
    },
    "phdy_funds": {
      "schema": "PhdyFundTransaction",
      "description": "Internal PHDY treasury transactions."
    }
  }
}
